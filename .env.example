# Recruvault environment. Copy to .env.local and fill in.
# Generate secrets with: openssl rand -hex 32

# --- Core ---
DATABASE_URL=postgres://recruvault:recruvault@localhost:5432/recruvault
APP_URL=http://localhost:3000
# Comma-separated hostnames the browser may connect to and load images from.
TRUSTED_DOMAINS=localhost
# Reverse proxies in front of the app. Rate limits read the client address
# this many hops from the right of X-Forwarded-For. 0 = no proxy.
TRUSTED_PROXY_HOPS=1
# Session/signing secret for BetterAuth. Required.
BETTER_AUTH_SECRET=
# Optional dedicated secret for secure-link session cookies. Falls back to
# BETTER_AUTH_SECRET when unset.
LINK_SESSION_SECRET=
# Enabled in the local example so recruiter sign-up can be tested. Set false in
# production after the first owner uses /setup; job-seeker sign-up stays open.
ALLOW_RECRUITER_SIGNUP=true

# --- Encryption ---
# Deployment key for legacy envelopes and secure-link render delegation.
# Generate with: openssl rand -hex 32. Losing it makes legacy ciphertext
# unrecoverable. Customer workspace keys are separate and are not stored here.
LOCAL_KEK=
# One-time first-owner capability. Generate a fresh value per deployment.
# At least 32 characters. Never commit a real token or reuse one across installs.
BOOTSTRAP_TOKEN=
# Separate capability for an interrupted install that has an organisation row
# but no owner membership. Leave unset until that recovery is required.
BOOTSTRAP_RECOVERY_TOKEN=
AWS_REGION=ap-southeast-2

# --- Object storage (S3 or MinIO) ---
# Compose only: MinIO administrator. The app never receives these; minio-init
# creates the bucket-scoped app user below from AWS_ACCESS_KEY_ID/SECRET.
MINIO_ROOT_USER=recruvault-admin
MINIO_ROOT_PASSWORD=
AWS_ACCESS_KEY_ID=recruvault
AWS_SECRET_ACCESS_KEY=recruvault-secret
S3_BUCKET=recruvault-documents
# Point at MinIO for self-host, or leave unset to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Local MinIO needs a KMS before it can accept SSE-S3 uploads. Leave false for
# the bundled development stack; set true for configured providers.
S3_SERVER_SIDE_ENCRYPTION=false
# Set true if bucket versioning is on. Otherwise deletion leaves earlier
# (encrypted) versions behind as delete-marked objects.
S3_DELETE_ALL_VERSIONS=false

# --- Virus scanning (ClamAV clamd) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Dev-only escape hatch; refuses to run when NODE_ENV=production.
SCAN_DISABLED=false

# --- Email (Resend) ---
# Without RESEND_API_KEY, development records that mail was not sent and does
# not print the code or link. Production fails the send instead.
RESEND_API_KEY=
# Resend's test sender works locally but can send only to your Resend account
# email. For real recipients, use an address on a domain verified in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev
SHARED_SENDING_DOMAIN=mail.recruvault.example
# Required to accept Resend bounce/complaint webhooks (fail-closed without it).
RESEND_WEBHOOK_SECRET=

# --- SMS (AWS SNS), optional ---
SMS_ENABLED=false

# --- Observability ---
# Optional. When set, errors are reported to Sentry; unset = no-op.
SENTRY_DSN=
LOG_LEVEL=info

# --- Background jobs (Inngest) ---
# Local dev: set INNGEST_DEV=1 and run the Inngest dev server.
INNGEST_DEV=1
# Inngest Cloud (production): set these from your Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
